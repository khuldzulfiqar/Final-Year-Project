# --- Online meeting (Jitsi as a Service, free up to 25 monthly users) ---
# 1) Sign up at https://jaas.8x8.vc  2) Console > API Keys > Generate API key
# 3) Copy the values below. Without these, the app falls back to a plain meet.jit.si room (opens in a new tab).
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxx
# Full key id exactly as shown in the console, e.g. vpaas-magic-cookie-xxxxxxxx/abc123
JAAS_KEY_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxx/abc123
# Private key (the .pk file) on ONE line, replacing line breaks with \n
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# Used in reminder emails, e.g. https://your-site.com
APP_BASE_URL=http://localhost:3000
